# Used only by bot tests (vite-node --mode test) to point src/firebase.ts at
# the local Firebase Local Emulator Suite instead of the real project. Safe
# to commit: "demo-" is Firebase's reserved prefix for emulator-only projects
# that never touch a real backend, so none of these need to be real values.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-chaos-among-us.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-chaos-among-us
VITE_FIREBASE_PROJECT_ID=demo-chaos-among-us
VITE_FIREBASE_STORAGE_BUCKET=demo-chaos-among-us.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_FIREBASE_EMULATOR=true
